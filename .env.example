# Copy this file to .env.local and fill in the values.

# Supabase → Project Settings → API
# Server-only: never expose the service role / secret key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site (used for OG tags). On Vercel set it to your domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional ad tracking. Scripts load only when these are set.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
