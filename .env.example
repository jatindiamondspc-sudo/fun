# Copy this file to .env.local (on the VPS too) and fill in the values.

# Postgres on the same server. Keep it on 127.0.0.1, never open port 5432 to the internet.
DATABASE_URL=postgres://hercall:CHANGE_ME@127.0.0.1:5432/hercall

# Login for /admin (signups dashboard + CSV export). Use a long random password.
# Leave ADMIN_PASSWORD empty to switch /admin off.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Public URL of the site (used for link previews), e.g. https://hercall.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional ad tracking. Scripts load only when these are set.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
